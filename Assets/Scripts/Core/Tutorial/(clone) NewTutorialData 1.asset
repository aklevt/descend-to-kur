  m_Name: (clone) NewTutorialData 1
  m_EditorClassIdentifier: GameScripts::Core.Tutorial.TutorialData
  steps:
  - speakerName: "\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043A\u0430\u043C\u0435\u0440\u043E\u0439"
    text: "\u041F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u043D\u0430\u0447\u0430\u0442\u044C,
      \u0438\u0437\u0443\u0447\u0438\u0442\u0435 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435:\n\nWASD
      - \u0434\u0432\u0438\u0433\u0430\u0442\u044C \u043A\u0430\u043C\u0435\u0440\u0443\n\u041A\u043E\u043B\u0435\u0441\u0438\u043A\u043E
      - \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u044C\n\u041F\u041A\u041C
      - \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0438\u0433\u0440\u043E\u043A\u0443\n\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u043A\u0430\u043C\u0435\u0440\u0443, \u0447\u0442\u043E\u0431\u044B \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044E \u043D\u0430 \u043F\u043E\u043B\u0435!"
    speakerAvatar: {fileID: 0}
    requiredAction: 0
    targetIndex: 0
    targetCell: {x: 0, y: 0}
    hasAutoTrigger: 0
    triggerName: 
  - speakerName: "\u041F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0435 "
    text: "\u0414\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0435 \u043A\u043B\u0435\u0442\u043A\u0438
      \u0434\u043B\u044F \u0445\u043E\u0434\u0430 \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F
      \u044F\u0440\u043A\u0438\u043C \u0446\u0432\u0435\u0442\u043E\u043C.\n\u041D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043D\u0430 \u043E\u0434\u043D\u0443 \u0438\u0437 \u043D\u0438\u0445, \u0447\u0442\u043E\u0431\u044B
      \u0438\u0433\u0440\u043E\u043A \u043F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u043B\u0441\u044F
      \n\n\u0418\u0434\u0438\u0442\u0435 \u0432\u043F\u0440\u0430\u0432\u043E, \u0447\u0442\u043E\u0431\u044B
      \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0434\u043E \u0446\u0435\u043B\u0438!\n\n[\u0410\u0432\u0442\u043E-\u043F\u0435\u0440\u0435\u0445\u043E\u0434
      \u043F\u0440\u0438 \u0432\u0445\u043E\u0434\u0435 \u0432 2 \u0441\u0435\u043A\u0446\u0438\u044E]"
    speakerAvatar: {fileID: 0}
    requiredAction: 4
    targetIndex: 1
    targetCell: {x: 0, y: 0}
    hasAutoTrigger: 0
    triggerName: 
  - speakerName: "\u0412\u043F\u0435\u0440\u0435\u0434\u0438 \u0432\u0440\u0430\u0433!"
    text: "\u041D\u0430\u0432\u0435\u0434\u0438\u0442\u0435 \u043A\u0443\u0440\u0441\u043E\u0440
      \u043D\u0430 \u0432\u0440\u0430\u0433\u0430, \u0447\u0442\u043E\u0431\u044B
      \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0435\u0433\u043E \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438
      \u0438 \u0440\u0430\u0434\u0438\u0443\u0441 \u0430\u0442\u0430\u043A\u0438\n\n\u041A\u0440\u0430\u0441\u043D\u043E\u0439
      \u0437\u043E\u043D\u043E\u0439 \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0435\u043D\u0430
      \u0437\u043E\u043D\u0430 \u0435\u0433\u043E \u0430\u0442\u0430\u043A\u0438\n\n[\u0410\u0432\u0442\u043E-\u043F\u0435\u0440\u0435\u0445\u043E\u0434
      \u043F\u0440\u0438 \u043D\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u0438 \u043D\u0430
      \u0432\u0440\u0430\u0433\u0430]\n"
    speakerAvatar: {fileID: 0}
    requiredAction: 5
    targetIndex: 0
    targetCell: {x: 0, y: 0}
    hasAutoTrigger: 0
    triggerName: 
  - speakerName: "\u0412\u043F\u0435\u0440\u0435\u0434\u0438 \u0432\u0440\u0430\u0433!"
    text: "\u041A\u0440\u0430\u0441\u043D\u043E\u0439 \u0437\u043E\u043D\u043E\u0439
      \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0435\u043D\u0430 \u0437\u043E\u043D\u0430
      \u0435\u0433\u043E \u0430\u0442\u0430\u043A\u0438\n\n\u0417\u0430\u0436\u043C\u0438\u0442\u0435
      [Alt], \u0447\u0442\u043E\u0431\u044B \u0443\u0432\u0438\u0434\u0435\u0442\u044C
      \u0437\u043E\u043D\u0443 \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u044F
      \u043C\u043E\u043D\u0441\u0442\u0440\u0430!\n\n[\u0410\u0432\u0442\u043E-\u043F\u0435\u0440\u0435\u0445\u043E\u0434
      \u043F\u0440\u0438 \u043D\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u0438 \u043D\u0430
      \u0432\u0440\u0430\u0433\u0430]\n"
    speakerAvatar: {fileID: 0}
    requiredAction: 6
    targetIndex: 0
    targetCell: {x: 0, y: 0}
    hasAutoTrigger: 0
    triggerName: 
  - speakerName: "\u041F\u0440\u0438\u0431\u043B\u0438\u0437\u0442\u0435\u0441\u044C
      \u043A \u0432\u0440\u0430\u0433\u0443"
    text: "\u0427\u0442\u043E\u0431\u044B \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C,
      \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0434\u043E\u0439\u0442\u0438 \u043A
      \u0432\u0440\u0430\u0433\u0443 \u0431\u043B\u0438\u0436\u0435\n\n[\u0410\u0432\u0442\u043E-\u043F\u0435\u0440\u0435\u0445\u043E\u0434
      \u043F\u0440\u0438 \u0441\u0431\u043B\u0438\u0436\u0435\u043D\u0438\u0438 \u0441
      \u0432\u0440\u0430\u0433\u043E\u043C]"
    speakerAvatar: {fileID: 0}
    requiredAction: 7
    targetIndex: 0
    targetCell: {x: 0, y: 0}
    hasAutoTrigger: 0
    triggerName: 
  - speakerName: "\u0421\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438"
    text: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 [2] \u043D\u0430 \u043A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0435
      \u0438\u043B\u0438 \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C
      \"\u0431\u043B\u0438\u0436\u043D\u044F\u044F \u0430\u0442\u0430\u043A\u0430\"\n\n[\u0410\u0432\u0442\u043E-\u043F\u0435\u0440\u0435\u0445\u043E\u0434
      \u043F\u043E\u0441\u043B\u0435 \u0432\u044B\u0431\u043E\u0440\u0430 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438]"
    speakerAvatar: {fileID: 0}
    requiredAction: 1
    targetIndex: 1
    targetCell: {x: 0, y: 0}
    hasAutoTrigger: 0
    triggerName: 
  - speakerName: "\u0410\u0442\u0430\u043A\u0443\u0439\u0442\u0435 \u0438 \u0434\u043E\u0431\u0435\u0439\u0442\u0435
      \u0432\u0440\u0430\u0433\u0430!"
    text: "\u0422\u0435\u043F\u0435\u0440\u044C \u043A\u043B\u0438\u043A\u043D\u0438\u0442\u0435
      \u043D\u0430 \u0432\u0440\u0430\u0433\u0430, \u0447\u0442\u043E\u0431\u044B
      \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C \u0435\u0433\u043E.
      \u041A\u0440\u0430\u0441\u043D\u044B\u0435 \u043A\u043B\u0435\u0442\u043A\u0438
      - \u0437\u043E\u043D\u0430 \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F
      \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0439 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438,
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u043C\u043E\u0436\u043D\u043E
      \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u044C \u043C\u043D\u043E\u0433\u043E
      \u0440\u0430\u0437\n\n[\u0410\u0432\u0442\u043E-\u043F\u0435\u0440\u0435\u0445\u043E\u0434
      \u043F\u043E\u0441\u043B\u0435 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u0438\u044F
      \u043C\u043E\u043D\u0441\u0442\u0440\u0430]"
    speakerAvatar: {fileID: 0}
    requiredAction: 8
    targetIndex: 0
    targetCell: {x: 0, y: 0}
    hasAutoTrigger: 0
    triggerName: 
  - speakerName: "\u041F\u043E\u043C\u043D\u0438\u0442\u0435 \u043E\u0431 \u044D\u043D\u0435\u0440\u0433\u0438\u0438!"
    text: "\u0421\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438 \u0442\u0440\u0430\u0442\u044F\u0442
      \u044D\u043D\u0435\u0440\u0433\u0438\u044E \r\n\r\n\u0414\u043B\u044F \u0448\u0430\u0433\u043E\u0432
      \u0435\u0441\u0442\u044C \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u0435:
      4 \u0448\u0430\u0433\u0430/\u0445\u043E\u0434 \r\n\r\n\u042D\u043D\u0435\u0440\u0433\u0438\u044F
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432 \u043A\u043E\u043D\u0446\u0435 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u0445\u043E\u0434\u0430\n\n\u0413\u0440\u0430\u043C\u043E\u0442\u043D\u043E
      \u043A\u043E\u043C\u0431\u0438\u043D\u0438\u0440\u0443\u0439\u0442\u0435 \u0438\u043C\u0435\u044E\u0449\u0438\u0435\u0441\u044F
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438, \u0447\u0442\u043E\u0431\u044B
      \u0432\u044B\u0436\u0438\u0442\u044C!"
