  - speakerName: "\u0412\u0440\u0435\u043C\u044F \u0432\u044B\u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F!"
    text: "\u0418\u0434\u0438\u0442\u0435 \u0432\u043F\u0440\u0430\u0432\u043E, \u0447\u0442\u043E\u0431\u044B
