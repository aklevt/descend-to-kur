  m_Script: {fileID: 11500000, guid: 63b2012d332509944b395eb062686198, type: 3}
  m_Name: Intro
  m_EditorClassIdentifier: GameScripts::UI.DialogueData
  lines:
  - text: "\u0412\u044B \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u043B\u0438\u0441\u044C
      \u0434\u043E\u043C\u043E\u0439 \u043F\u043E\u0441\u043B\u0435 \u0443\u0441\u043F\u0435\u0448\u043D\u043E\u0433\u043E
      \u0432\u043E\u0435\u043D\u043D\u043E\u0433\u043E \u043F\u043E\u0445\u043E\u0434\u0430.
      \u0427\u0443\u0434\u043E\u0432\u0438\u0449\u0435, \u043F\u043E\u0441\u0435\u043B\u0438\u0432\u0448\u0435\u0435\u0441\u044F
      \u0432 \u043E\u043A\u0440\u0435\u0441\u0442\u043D\u044B\u0445 \u043B\u0435\u0441\u0430\u0445,
      \u0431\u044B\u043B\u043E \u043F\u043E\u0432\u0435\u0440\u0436\u0435\u043D\u043E,
      \u0432\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438 \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u0439
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u0446\u0435\u043D\u043D\u043E\u0439
      \u043A\u0435\u0434\u0440\u043E\u0432\u043E\u0439 \u0434\u0440\u0435\u0432\u0438\u0441\u0438\u043D\u044B,
      \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0431\u044B\u043B\u0430 \u0442\u0430\u043A
      \u0440\u0435\u0434\u043A\u0430 \u0432 \u044D\u0442\u0438\u0445 \u043F\u0443\u0441\u0442\u044B\u043D\u043D\u044B\u0445
      \u043A\u0440\u0430\u044F\u0445..."
    speakerName: 
    speakerPortrait: {fileID: -5621593187482372676, guid: c8e0430e86ea84e4290e948b661302f1, type: 3}
    showInlineImage: 0
    textAlignment: 1
    delayAfter: 0.5
  - text: "\u0418 \u0441\u0430\u043C\u043E\u0435 \u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0435
      - \u0432 \u0431\u0438\u0442\u0432\u0435 \u0441 \u0447\u0443\u0434\u043E\u0432\u0438\u0449\u0435\u043C
      \u0432\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438 \u043B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u044B\u0439
      \u0431\u0430\u0440\u0430\u0431\u0430\u043D, \u043E\u0434\u0438\u043D \u0437\u0432\u0443\u043A
      \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0432\u0441\u0435\u043B\u044F\u043B
      \u0441\u0442\u0430\u0440\u0445 \u0432 \u0441\u0435\u0440\u0434\u0446\u0430
      \u043B\u044E\u0434\u0435\u0439 \u0438 \u043C\u043E\u0433 \u043E\u0431\u0440\u0430\u0442\u0438\u0442\u044C
      \u0432 \u0431\u0435\u0433\u0441\u0442\u0432\u043E \u0446\u0435\u043B\u0443\u044E
      \u0430\u0440\u043C\u0438\u044E."
    speakerName: 
    speakerPortrait: {fileID: 6204292584936857487, guid: 2f8095cbb1cf2844aa30f9c8a4dd5ee7, type: 3}
    showInlineImage: 1
    textAlignment: 0
    delayAfter: 0.3
  - text: "\u0412\u044B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C
      \u043D\u0430 \u043F\u0440\u0438\u0432\u0430\u043B, \u043F\u0440\u0435\u0434\u0432\u043A\u0443\u0448\u0430\u044F
      \u0442\u0440\u0438\u0443\u043C\u0444\u0430\u043B\u044C\u043D\u043E\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435
      \u0432 \u0433\u043E\u0440\u043E\u0434. \u041D\u043E \u0432\u0430\u0448\u0430
      \u043F\u043E\u0431\u0435\u0434\u0430 \u043D\u0435 \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044C
      \u0431\u043E\u0433\u0430\u043C: \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E
      \u0437\u0435\u043C\u043B\u044F \u0440\u0430\u0437\u0432\u0435\u0440\u0437\u043B\u0430\u0441\u044C
      \u043F\u0435\u0440\u0435\u0434 \u0432\u0430\u043C\u0438, \u0438 \u043B\u0438\u0448\u044C
      \u0447\u0443\u0434\u043E\u043C \u0432\u044B \u043D\u0435 \u0443\u043F\u0430\u043B\u0438
      \u0432 \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0439 \u0440\u0430\u0437\u043B\u043E\u043C,
      \u0432\u0435\u0434\u0443\u0449\u0438\u0439 \u0434\u043E \u0441\u0430\u043C\u043E\u0433\u043E
      \u043F\u043E\u0434\u0437\u0435\u043C\u043D\u043E\u0433\u043E \u0446\u0430\u0440\u0441\u0442\u0432\u0430.
      \u0421 \u043D\u0435\u0431\u0430 \u0443\u0434\u0430\u0440\u0438\u043B\u0438
      \u043C\u043E\u043B\u043D\u0438\u0438, \u0430 \u043F\u043E\u0442\u043E\u043C
      \u0440\u0430\u0437\u043B\u043E\u043C \u0437\u0430\u0442\u044F\u043D\u0443\u043B\u0441\u044F.
      \u0412\u044B \u0441\u043C\u043E\u0433\u043B\u0438 \u0441\u043F\u0430\u0441\u0442\u0438\u0441\u044C,
      \u043D\u043E \u0432\u0441\u0435 \u0432\u0430\u0448\u0438 \u0442\u0440\u043E\u0444\u0435\u0438,
      \u0432 \u0442\u043E\u043C \u0447\u0438\u0441\u043B\u0435 \u0438 \u043B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u044B\u0439
      \u0431\u0430\u0440\u0430\u0431\u0430\u043D, \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C\r\n\u043F\u043E\u0433\u0440\u0435\u0431\u0435\u043D\u044B
      \u043F\u043E\u0434 \u0437\u0435\u043C\u043B\u0435\u0439."
    speakerName: 
    speakerPortrait: {fileID: -2311659948842064771, guid: f9f8b894730c3bc418d072ad5f9f608e, type: 3}
    showInlineImage: 0
    textAlignment: 1
    delayAfter: 0.3
  - text: "\u041A\u0430\u043A \u043C\u044B \u043C\u043E\u0433\u043B\u0438 \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C
      \u0435\u0433\u043E \u0438\u043C\u0435\u043D\u043D\u043E \u0441\u0435\u0439\u0447\u0430\u0441,
      \u043A\u043E\u0433\u0434\u0430 \u043C\u044B \u0432\u043E\u044E\u0435\u043C
      \u0441 \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u043C \u0433\u043E\u0440\u043E\u0434\u043E\u043C?
      \u042D\u0442\u043E\u0442 \u0431\u0430\u0440\u0430\u0431\u0430\u043D \u0431\u044B\u043B
      \u043D\u0430\u0448\u0435\u0439 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C
      \u0448\u0430\u043D\u0441\u043E\u043C \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u044C\u2026\n\u041C\u044B
      \u0434\u043E\u043B\u0436\u043D\u044B \u0432\u0435\u0440\u043D\u0443\u0442\u044C
      \u0435\u0433\u043E!"
    speakerName: "\u041B\u0443\u0433\u0430\u043B\u044C"
    speakerPortrait: {fileID: 0}
    showInlineImage: 0
    textAlignment: 0
    delayAfter: 0.3
  - text: "\u0411\u0443\u0434\u0435\u0442 \u043F\u043B\u043E\u0445\u043E, \u0435\u0441\u043B\u0438
      \u0433\u043E\u0440\u043E\u0434 \u043F\u0435\u0440\u0435\u0434 \u0432\u043E\u0439\u043D\u043E\u0439
      \u043B\u0438\u0448\u0438\u0442\u0441\u044F \u0446\u0430\u0440\u044F, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u044F \u043F\u043E\u0439\u0434\u0443 \u043E\u0434\u0438\u043D. \u042F \u0441\u043F\u0443\u0449\u0443\u0441\u044C
      \u0432 \u043F\u043E\u0434\u0437\u0435\u043C\u043D\u043E\u0435 \u0446\u0430\u0440\u0441\u0442\u0432\u043E
      \u0438 \u0432\u0435\u0440\u043D\u0443 \u0431\u0430\u0440\u0430\u0431\u0430\u043D."
    speakerName: "\u0412\u044B"
    speakerPortrait: {fileID: 0}
    showInlineImage: 0
    textAlignment: 0
    delayAfter: 0.3
  style: 3
  canSkip: 1
