  m_Script: {fileID: 11500000, guid: 63b2012d332509944b395eb062686198, type: 3}
  m_Name: Outro
  m_EditorClassIdentifier: GameScripts::UI.Dialogue.DialogueData
  lines:
  - text: "\u0425\u043C, \u0441\u043C\u0435\u0440\u0442\u043D\u044B\u0439, \u0430
      \u0442\u044B \u043D\u0435\u043F\u043B\u043E\u0445. \u042F \u0440\u0435\u0448\u0438\u043B\u0430,
      \u0447\u0442\u043E \u0442\u044B\r\n\u0432\u0441\u0435-\u0442\u0430\u043A\u0438
      \u0434\u043E\u0441\u0442\u043E\u0438\u043D \u044D\u0442\u043E\u0433\u043E \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0430.
      \u0417\u0430\u0431\u0438\u0440\u0430\u0439."
    speakerName: "\u0411\u043E\u0433\u0438\u043D\u044F \u043F\u043E\u0434\u0437\u0435\u043C\u043D\u043E\u0433\u043E
      \u0446\u0430\u0440\u0441\u0442\u0432\u0430"
    speakerPortrait: {fileID: 0}
    showInlineImage: 0
    textAlignment: 0
    delayAfter: 0
  - text: "\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0443\u043C\u0443
      \u0438 \u0445\u0438\u0442\u0440\u043E\u0441\u0442\u0438 \u0432\u044B \u0441\u043C\u043E\u0433\u043B\u0438
      \u0441\u043F\u0443\u0441\u0442\u0438\u0442\u044C\u0441\u044F \u0432 \u043F\u043E\u0434\u0437\u0435\u043C\u043D\u043E\u0435
      \u0446\u0430\u0440\u0441\u0442\u0432\u043E \u0438 \u0434\u043E\u0441\u0442\u0430\u0442\u044C
      \u043E\u0442\u0442\u0443\u0434\u0430 \u043B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u044B\u0439
      \u0431\u0430\u0440\u0430\u0431\u0430\u043D. \n\u0412\u043E\u0439\u0441\u043A\u043E
      \u0410\u0433\u0433\u0438 \u0431\u044B\u043B\u043E \u0440\u0430\u0437\u0433\u0440\u043E\u043C\u043B\u0435\u043D\u043E,
      \u0430 \u0423\u0440\u0443\u043A \u0441\u0442\u0430\u043B \u0441\u0430\u043C\u044B\u043C
      \u043A\u0440\u0443\u043F\u043D\u044B\u043C \u0438 \u043F\u0440\u043E\u0446\u0432\u0435\u0442\u0430\u044E\u0449\u0438\u043C
      \u0433\u043E\u0440\u043E\u0434\u043E\u043C \u041C\u0435\u0436\u0434\u0443\u0440\u0435\u0447\u044C\u044F."
    speakerName: 
    speakerPortrait: {fileID: 0}
